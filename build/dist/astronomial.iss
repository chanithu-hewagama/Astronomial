; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "Astronomial"
#define MyAppVersion "1.0.0"
#define MyAppURL "http://astronomial.onthewifi.com/"
#define MyAppPublisher "Astronomial"
#define MyAppExeName "astronomial.exe"
#define MyAppAssocName MyAppName + " Plugin File"
#define MyAppAssocExt ".apf"
#define MyAppAssocKey StringChange(MyAppAssocName, " ", "") + MyAppAssocExt

[Setup]
AppId={{7FC6F850-9024-4A0F-B26C-535D67F7F6AC}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName=C:\{#MyAppName}
DefaultGroupName={#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
ChangesAssociations=yes
ChangesEnvironment=yes
DisableProgramGroupPage=yes
PrivilegesRequired=admin
OutputDir=..\..\release
OutputBaseFilename=Astronomial-Setup-V1.0.0-x64
Compression=lzma2
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "adddata\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "adddata\astro.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "adddata\*.dll"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "adddata\tools\*"; DestDir: "{app}\tools"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "adddata\ephe\*"; DestDir: "{localappdata}\.astronomial\ephe"; Flags: ignoreversion recursesubdirs createallsubdirs

[Registry]
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocExt}\OpenWithProgids"; ValueType: string; ValueName: "{#MyAppAssocKey}"; ValueData: ""; Flags: uninsdeletevalue
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}"; ValueType: string; ValueName: ""; ValueData: "{#MyAppAssocName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""

; Save a supplied Telegram bot token as a machine environment variable.
Root: HKLM; Subkey: "SYSTEM\CurrentControlSet\Control\Session Manager\Environment"; ValueType: string; ValueName: "ASTRONOMIAL_BOT_TOKEN"; ValueData: "{code:GetBotTokenValue}"; Flags: uninsdeletevalue; Check: HasBotToken

; Add application directory to the system PATH only if it is not already present.
Root: HKLM; Subkey: "SYSTEM\CurrentControlSet\Control\Session Manager\Environment"; ValueType: expandsz; ValueName: "Path"; ValueData: "{code:GetUpdatedPath}"; Check: NeedsAddPath('{app}')

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\Astronomial Command Line"; Filename: "{app}\astro.exe"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
var
  BotTokenPage: TInputQueryWizardPage;

const
  AstronomialRegistryKey = 'Astronomial';
  AstronomialUIDValue = 'UID';

function SendMessageTimeout(hWnd: HWND; Msg: UINT; wParam: UINT;
  lParam: String; fuFlags: UINT; uTimeout: UINT;
  var lpdwResult: DWORD): DWORD;
  external 'SendMessageTimeoutW@user32.dll stdcall';

function IsCanonicalUUID(const Value: string): Boolean;
begin
  Result :=
    (Length(Value) = 38) and
    (Value[1] = '{') and (Value[38] = '}') and
    (Value[10] = '-') and (Value[15] = '-') and
    (Value[20] = '-') and (Value[25] = '-') and
    (Pos(' ', Value) = 0);
end;

function GenerateRandomUUID(): string;
begin
  Result := Format('{%0.8x-%0.4x-%0.4x-%0.4x-%0.8x%0.4x}', [
    Random($FFFFFFFF),
    Random($FFFF),
    (Random($0FFF) or $4000),
    (Random($03FF) or $8000),
    Random($FFFFFFFF),
    Random($FFFF)
  ]);
end;

function EnsureAstronomialUID(): string;
var
  ExistingUID, NewUID: string;
begin
  if RegQueryStringValue(HKLM, AstronomialRegistryKey, AstronomialUIDValue, ExistingUID) and
     IsCanonicalUUID(ExistingUID) then begin
    Result := ExistingUID;
    exit;
  end;
  NewUID := GenerateRandomUUID();
  if not IsCanonicalUUID(NewUID) then
    RaiseException('Could not create a valid Astronomial UID.');
  RegWriteStringValue(HKLM, AstronomialRegistryKey, AstronomialUIDValue, NewUID);
  Result := NewUID;
end;

procedure InitializeWizard;
begin
  BotTokenPage := CreateInputQueryPage(wpWelcome,
    'Telegram Bot Configuration', 'Enter your Telegram Bot Token',
    'Enter a token to set or replace the machine-wide ASTRONOMIAL_BOT_TOKEN environment variable. Leave blank to keep the current value.');
  BotTokenPage.Add('Bot Token:', True);
end;

function GetBotTokenValue(Param: string): string;
begin
  Result := BotTokenPage.Values[0];
end;

function HasBotToken(): Boolean;
begin
  Result := Trim(BotTokenPage.Values[0]) <> '';
end;

function NormalizePath(const Value: string): string;
begin
  Result := Lowercase(Trim(Value));
  if (Length(Result) >= 2) and (Result[1] = '"') and
     (Result[Length(Result)] = '"') then begin
    Delete(Result, Length(Result), 1);
    Delete(Result, 1, 1);
  end;
  while (Length(Result) > 0) and (Result[Length(Result)] = '\') do
    Delete(Result, Length(Result), 1);
end;

function PathContains(const CurrentPath, PathToFind: string): Boolean;
var
  Remaining, Entry: string;
  SeparatorPos: Integer;
begin
  Result := False;
  Remaining := CurrentPath;
  while True do begin
    SeparatorPos := Pos(';', Remaining);
    if SeparatorPos = 0 then
      Entry := Trim(Remaining)
    else
      Entry := Trim(Copy(Remaining, 1, SeparatorPos - 1));
    if NormalizePath(Entry) = NormalizePath(PathToFind) then begin
      Result := True;
      exit;
    end;
    if SeparatorPos = 0 then
      exit;
    Delete(Remaining, 1, SeparatorPos);
  end;
end;

function NeedsAddPath(Param: string): boolean;
var
  OrigPath: string;
begin
  if not RegQueryStringValue(HKEY_LOCAL_MACHINE,
    'SYSTEM\CurrentControlSet\Control\Session Manager\Environment',
    'Path', OrigPath) then
  begin
    Result := True;
    exit;
  end;
  Result := not PathContains(OrigPath, Param);
end;

function GetUpdatedPath(Param: string): string;
var
  OrigPath: string;
begin
  if RegQueryStringValue(HKEY_LOCAL_MACHINE,
    'SYSTEM\CurrentControlSet\Control\Session Manager\Environment',
    'Path', OrigPath) and (Trim(OrigPath) <> '') then
    Result := OrigPath + ';' + ExpandConstant('{app}')
  else
    Result := ExpandConstant('{app}');
end;

function PathWithoutEntry(const CurrentPath, PathToRemove: string): string;
var
  Remaining, Entry: string;
  SeparatorPos: Integer;
  FirstEntry: Boolean;
begin
  Result := '';
  Remaining := CurrentPath;
  FirstEntry := True;
  while True do begin
    SeparatorPos := Pos(';', Remaining);
    if SeparatorPos = 0 then
      Entry := Remaining
    else
      Entry := Copy(Remaining, 1, SeparatorPos - 1);
    if NormalizePath(Entry) <> NormalizePath(PathToRemove) then begin
      if not FirstEntry then
        Result := Result + ';';
      Result := Result + Entry;
      FirstEntry := False;
    end;
    if SeparatorPos = 0 then
      exit;
    Delete(Remaining, 1, SeparatorPos);
  end;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  EphePath: string;
begin
  Result := '';
  EnsureAstronomialUID();

  { Ensure the ephemeris directory exists in the user's local appdata }
  EphePath := ExpandConstant('{localappdata}\.astronomial\ephe');
  if not DirExists(EphePath) then
    ForceDirectories(EphePath);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  ExistingPath, UpdatedPath: string;
  MessageResult: DWORD;
begin
  if CurUninstallStep = usPostUninstall then begin
    if RegQueryStringValue(HKLM,
      'SYSTEM\CurrentControlSet\Control\Session Manager\Environment',
      'Path', ExistingPath) then begin
      UpdatedPath := PathWithoutEntry(ExistingPath, ExpandConstant('{app}'));
      if UpdatedPath <> ExistingPath then begin
        if UpdatedPath = '' then
          RegDeleteValue(HKLM,
            'SYSTEM\CurrentControlSet\Control\Session Manager\Environment', 'Path')
        else
          RegWriteExpandStringValue(HKLM,
            'SYSTEM\CurrentControlSet\Control\Session Manager\Environment',
            'Path', UpdatedPath);
        SendMessageTimeout($FFFF, $001A, 0, 'Environment', $0002,
          5000, MessageResult);
      end;
    end;
  end;
end;